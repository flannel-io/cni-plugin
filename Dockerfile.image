FROM --platform=$BUILDPLATFORM tonistiigi/xx@sha256:40fe21f44bb8cddf1eb1226db190d0a984118f62ee02a91b77d99448d28264a6 AS xx

FROM --platform=$BUILDPLATFORM golang:1.27.4-alpine3.24@sha256:70bd7ddea8b6cbe5d6943cde279d6b67feb10cc924fb9100d1d8757c1575b280 AS build
# copy xx scripts to your build stage
COPY --from=xx / /
ARG TARGETARCH
RUN apk --no-cache add bash make git
WORKDIR /go/src/github.com/flannel-io/cni-plugin
RUN --mount=type=bind,readwrite,target=/go/src/github.com/flannel-io/cni-plugin \
    go mod tidy && go mod vendor
RUN --mount=type=bind,readwrite,target=/go/src/github.com/flannel-io/cni-plugin \
    ARCH=${TARGETARCH} make build_linux &&\
    mv ./dist/flannel-${TARGETARCH} /flannel

FROM alpine:3.24@sha256:be2656061b536c1883c4034790e21d0a09c5aaaf51968b89368a3c0371ea2c9a
ARG GOARCH
COPY --from=build /flannel /flannel

